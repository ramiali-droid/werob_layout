<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.9">
  <model name="patrol_rover">
    <static>false</static>
    <pose>0 0 0.18 0 0 0</pose>
    <link name="base_link">
      <pose>0 0 0.18 0 0 0</pose>
      <inertial>
        <mass>8</mass>
        <inertia>
          <ixx>.20</ixx>
          <iyy>.35</iyy>
          <izz>.42</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry>
          <box>
            <size>.80 .50 .20</size>
          </box>
        </geometry>
        <material>
          <diffuse>.12 .20 .32 1</diffuse>
        </material>
      </visual>
      <collision name="collision">
        <geometry>
          <box>
            <size>.80 .50 .20</size>
          </box>
        </geometry>
      </collision>
      <sensor name="body_contact" type="contact">
        <always_on>true</always_on>
        <update_rate>20</update_rate>
        <topic>/patrol/contacts</topic>
        <contact>
          <collision>collision</collision>
          <topic>/patrol/contacts</topic>
        </contact>
      </sensor>
    </link>
    <link name="front_left_wheel">
      <pose>.25 .30 0 -1.5708 0 0</pose>
      <inertial>
        <mass>.6</mass>
        <inertia>
          <ixx>.006</ixx>
          <iyy>.006</iyy>
          <izz>.006</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>.17</radius>
            <length>.10</length>
          </cylinder>
        </geometry>
        <material>
          <diffuse>.04 .04 .04 1</diffuse>
        </material>
      </visual>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>.17</radius>
            <length>.10</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1</mu>
              <mu2>1</mu2>
              <slip1>.02</slip1>
              <slip2>0</slip2>
              <fdir1>0 0 1</fdir1>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>
    <link name="front_right_wheel">
      <pose>.25 -.30 0 -1.5708 0 0</pose>
      <inertial>
        <mass>.6</mass>
        <inertia>
          <ixx>.006</ixx>
          <iyy>.006</iyy>
          <izz>.006</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>.17</radius>
            <length>.10</length>
          </cylinder>
        </geometry>
        <material>
          <diffuse>.04 .04 .04 1</diffuse>
        </material>
      </visual>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>.17</radius>
            <length>.10</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1</mu>
              <mu2>1</mu2>
              <slip1>.02</slip1>
              <slip2>0</slip2>
              <fdir1>0 0 1</fdir1>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>
    <link name="rear_left_wheel">
      <pose>-.25 .30 0 -1.5708 0 0</pose>
      <inertial>
        <mass>.6</mass>
        <inertia>
          <ixx>.006</ixx>
          <iyy>.006</iyy>
          <izz>.006</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>.17</radius>
            <length>.10</length>
          </cylinder>
        </geometry>
        <material>
          <diffuse>.04 .04 .04 1</diffuse>
        </material>
      </visual>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>.17</radius>
            <length>.10</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1</mu>
              <mu2>1</mu2>
              <slip1>.02</slip1>
              <slip2>0</slip2>
              <fdir1>0 0 1</fdir1>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>
    <link name="rear_right_wheel">
      <pose>-.25 -.30 0 -1.5708 0 0</pose>
      <inertial>
        <mass>.6</mass>
        <inertia>
          <ixx>.006</ixx>
          <iyy>.006</iyy>
          <izz>.006</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>.17</radius>
            <length>.10</length>
          </cylinder>
        </geometry>
        <material>
          <diffuse>.04 .04 .04 1</diffuse>
        </material>
      </visual>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>.17</radius>
            <length>.10</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1</mu>
              <mu2>1</mu2>
              <slip1>.02</slip1>
              <slip2>0</slip2>
              <fdir1>0 0 1</fdir1>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>
    <joint name="front_left_joint" type="revolute">
      <parent>base_link</parent>
      <child>front_left_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1.79769e+308</lower>
          <upper>1.79769e+308</upper>
        </limit>
      </axis>
    </joint>
    <joint name="front_right_joint" type="revolute">
      <parent>base_link</parent>
      <child>front_right_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1.79769e+308</lower>
          <upper>1.79769e+308</upper>
        </limit>
      </axis>
    </joint>
    <joint name="rear_left_joint" type="revolute">
      <parent>base_link</parent>
      <child>rear_left_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1.79769e+308</lower>
          <upper>1.79769e+308</upper>
        </limit>
      </axis>
    </joint>
    <joint name="rear_right_joint" type="revolute">
      <parent>base_link</parent>
      <child>rear_right_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1.79769e+308</lower>
          <upper>1.79769e+308</upper>
        </limit>
      </axis>
    </joint>
    <link name="lidar_link">
      <pose>.12 0 .36 0 0 0</pose>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>.07</radius>
            <length>.08</length>
          </cylinder>
        </geometry>
        <material>
          <diffuse>.8 .15 .05 1</diffuse>
        </material>
      </visual>
      <sensor name="lidar" type="gpu_lidar">
        <topic>scan</topic>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <visualize>true</visualize>
        <lidar>
          <scan>
            <horizontal>
              <samples>720</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>.12</min>
            <max>25</max>
            <resolution>.01</resolution>
          </range>
        </lidar>
      </sensor>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>.07</radius>
            <length>.08</length>
          </cylinder>
        </geometry>
      </collision>
    </link>
    <joint name="lidar_joint" type="fixed">
      <parent>base_link</parent>
      <child>lidar_link</child>
    </joint>
    <link name="camera_link">
      <pose>.43 0 .48 0 0 0</pose>
      <visual name="visual">
        <geometry>
          <box>
            <size>.08 .12 .08</size>
          </box>
        </geometry>
      </visual>
      <sensor name="camera" type="camera">
        <topic>camera/image</topic>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <visualize>true</visualize>
        <camera>
          <horizontal_fov>1.2</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
          </image>
          <clip>
            <near>.1</near>
            <far>30</far>
          </clip>
        </camera>
      </sensor>
      <collision name="collision">
        <geometry>
          <box>
            <size>.08 .12 .08</size>
          </box>
        </geometry>
      </collision>
      <sensor name="camera_contact" type="contact">
        <always_on>true</always_on>
        <update_rate>20</update_rate>
        <topic>/patrol/contacts</topic>
        <contact>
          <collision>collision</collision>
          <topic>/patrol/contacts</topic>
        </contact>
      </sensor>
    </link>
    <joint name="camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>
    </joint>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>front_left_joint</left_joint>
      <left_joint>rear_left_joint</left_joint>
      <right_joint>front_right_joint</right_joint>
      <right_joint>rear_right_joint</right_joint>
      <wheel_separation>0.60</wheel_separation>
      <wheel_radius>0.17</wheel_radius>
      <topic>/cmd_vel</topic>
      <odom_topic>/wheel_odometry</odom_topic>
      <max_linear_acceleration>1.5</max_linear_acceleration>
      <min_linear_acceleration>-2.5</min_linear_acceleration>
      <max_angular_acceleration>3.0</max_angular_acceleration>
      <min_angular_acceleration>-3.0</min_angular_acceleration>
    </plugin>
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>map</odom_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <odom_topic>/odom</odom_topic>
      <odom_publish_frequency>30</odom_publish_frequency>
      <dimensions>3</dimensions>
    </plugin>
  </model>
</sdf>