        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <visualize>true</visualize>
        <camera>
          <horizontal_fov>1.2</horizontal_fov>
          <image>
            <width>960</width>
            <height>720</height>
          </image>
          <clip>
            <near>0.1</near>
            <far>30</far>
